---
config:
  layout: elk
  elk:
    mergeEdges: false
    nodePlacementStrategy: BRANDES_KOEPF
  flowchart:
    defaultRenderer: elk
    curve: linear
  themeVariables:
    primaryColor: transparent
    secondaryColor: transparent
    tertiaryColor: transparent
    mainBkg: transparent
    nodeBorder: '#64748b'
    clusterBkg: transparent
    clusterBorder: '#64748b'
    lineColor: '#64748b'
---
flowchart TD
  classDef default fill:transparent,stroke:#64748b,stroke-width:1.5px
  subgraph n0["archigram"]
    subgraph n1["entrypoints"]
      subgraph n2["cli"]
        n5["cli.app (Typer apply/lint/diff/propose)"]
        n6["cli.diff_report (PR Regression Diff)"]
        n7["cli.markdown_sync (--sync-md Inline Blocks)"]
        n8["cli.pipeline (Zero-LLM Compile & Lint Orchestrator)"]
        n9["cli.self_trace (Live Trace Snapshotter)"]
      end
      subgraph n3["mcp"]
        n15["mcp.propose_loop (Bounded 3-Turn Repair Loop)"]
        n16["mcp.server (FastMCP Tools: digest, lint, preview)"]
      end
    end
    subgraph n4["features"]
      n10["features.digest (GraphDigestGenerator)"]
      n11["Emitter Slices (Mermaid/D2/PUML/LikeC4)"]
      n12["Ingestor Slices (DOT/SCIP/OTLP/Class/Python)"]
      n13["5-Gate Linter Slices"]
      n14["Reducer Slices (Structural & Trace)"]
    end
    n17["Ports & Domain Core"]
  end
  style n0 fill:transparent,stroke:#64748b,stroke-width:1px,stroke-dasharray:4 4
  style n1 fill:transparent,stroke:#64748b,stroke-width:1px,stroke-dasharray:4 4
  style n2 fill:transparent,stroke:#64748b,stroke-width:1px,stroke-dasharray:4 4
  style n3 fill:transparent,stroke:#64748b,stroke-width:1px,stroke-dasharray:4 4
  style n4 fill:transparent,stroke:#64748b,stroke-width:1px,stroke-dasharray:4 4
  n2 -.->|"imports"| n5
  n6 -.->|"imports"| n8
  n5 -.->|"imports"| n6
  n7 -.->|"imports"| n8
  n2 -.->|"imports"| n7
  n9 -.->|"imports"| n8
  n15 -.->|"imports"| n10
  n15 -.->|"imports"| n11
  n8 -.->|"imports"| n11
  n8 -.->|"imports"| n12
  n15 -.->|"imports"| n13
  n8 -.->|"imports"| n13
  n9 -.->|"imports"| n15
  n16 -.->|"imports"| n15
  n3 -.->|"imports"| n16
  n10 -.->|"imports"| n17
  n8 -.->|"imports"| n17
  n15 -.->|"imports"| n14
  n8 -.->|"imports"| n14
