vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    dark-theme-id: 200
  }
}
style.fill: transparent

triage_legend: "Triage Disposition Legend" {
  style.fill: transparent
  style.stroke: "#64748b"
  style.stroke-dash: 3
  keep_key: "[KEEP] Retained in final view" {
    style.fill: transparent
    style.stroke: "#10b981"
  }
  remove_key: "[REMOVE] Pruned / out-of-scope" {
    style.fill: transparent
    style.stroke: "#ef4444"
    style.stroke-dash: 5
  }
  bypass_key: "[BYPASS] Spliced intermediate" {
    style.fill: transparent
    style.stroke: "#f59e0b"
    style.stroke-dash: 5
  }
  collapse_key: "[COLLAPSE] Merged into supernode" {
    style.fill: transparent
    style.stroke: "#8b5cf6"
    style.stroke-dash: 5
  }
}

