        }
        "archigram.entrypoints.cli.app.diff_cmd": "diff_cmd" {
          style.fill: transparent
          style.stroke: "#64748b"
        }
        "archigram.entrypoints.cli.app.execute_apply": "execute_apply" {
          style.fill: transparent
