vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    dark-theme-id: 200
  }
}
style.fill: transparent

direction: down
uml_initial: "●" {
  shape: circle
  style.fill: transparent
  style.stroke: "#64748b"
}
uml_final: "◉" {
  shape: circle
  style.double-border: true
  style.fill: transparent
  style.stroke: "#64748b"
}
