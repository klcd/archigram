          style.fill: transparent
          style.stroke: "#64748b"
        }
        "archigram.entrypoints.cli.curate_cli.collapse_cmd": "collapse_cmd" {
          style.fill: transparent
          style.stroke: "#64748b"
        }
        "archigram.entrypoints.cli.curate_cli.delete_rule_cmd": "delete_rule_cmd" {
