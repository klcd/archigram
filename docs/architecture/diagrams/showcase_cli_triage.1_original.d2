vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    dark-theme-id: 200
  }
}
style.fill: transparent

archigram: "archigram" {
  style.fill: transparent
  style.stroke: "#64748b"
  "archigram.domain": "domain" {
    style.fill: transparent
    style.stroke: "#64748b"
    "archigram.domain.ProvenanceGrade": "ProvenanceGrade" {
      style.fill: transparent
      style.stroke: "#64748b"
    }
    "archigram.domain.ProvenanceStamp": "ProvenanceStamp" {
      shape: class
      "+grade": "ProvenanceGrade"
      "+extractor": "str | None"
      "+input_sha256": "str | None"
      "+file_path": "str | None"
      "+line_span": "tuple[int, int] | None"
      "+rule_id": "str | None"
      "+backing_ids": "tuple[str, ...]"
    }
    "archigram.domain.concurrency": "concurrency" {
      style.fill: transparent
      style.stroke: "#64748b"
      "archigram.domain.concurrency.CausalTraceEvent": "CausalTraceEvent" {
        shape: class
        "+property event_id()": "str"
        "+property caller_id()": "str"
        "+property callee_id()": "str"
        "+property parent_event_id()": "str | None"
        "+property causal_links()": "tuple[str, ...]"
        "+property clock_domain_id()": "str"
        "+property start_ns()": "int"
        "+property end_ns()": "int"
      }
      "archigram.domain.concurrency.ConcurrencyMode": "ConcurrencyMode" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.concurrency.ParallelMapSummary": "ParallelMapSummary" {
        shape: class
        "+parent_event_id": "NonBlankStr | None"
        "+clock_domain_id": "NonBlankStr"
        "+callee_id": "NonBlankStr"
        "+signature": "NonBlankStr"
        "+concurrency_count": "int"
        "+backing_ids": "tuple[NonBlankStr, ...]"
        "+window_start_ns": "int"
        "+window_end_ns": "int"
        "-_validate_summary()": "ParallelMapSummary"
      }
      "archigram.domain.concurrency.ParallelSiblingCluster": "ParallelSiblingCluster" {
        shape: class
        "+parent_event_id": "NonBlankStr | None"
        "+clock_domain_id": "NonBlankStr"
        "+event_ids": "tuple[NonBlankStr, ...]"
        "+window_start_ns": "int"
        "+window_end_ns": "int"
        "-_validate_window()": "ParallelSiblingCluster"
      }
      "archigram.domain.concurrency.PosetCotreeNode": "PosetCotreeNode" {
        shape: class
        "+kind": "PosetModuleKind"
        "+concurrency_mode": "ConcurrencyMode"
        "+node_id": "NonBlankStr | None"
        "+children": "tuple[PosetCotreeNode, ...]"
        "+prime_child_edges": "tuple[tuple[int, int], ...]"
        "+induced_n_witness": "tuple[NonBlankStr, NonBlankStr, NonBlankStr, NonBlankStr] | None"
        "-_validate_cotree_node()": "PosetCotreeNode"
      }
      "archigram.domain.concurrency.PosetModuleKind": "PosetModuleKind" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.concurrency.SpanInterval": "SpanInterval" {
        shape: class
        "+event_id": "NonBlankStr"
        "+parent_event_id": "NonBlankStr | None"
        "+clock_domain_id": "NonBlankStr"
        "+start_ns": "int"
        "+end_ns": "int"
        "+callee_id": "NonBlankStr | None"
        "+signature": "NonBlankStr | None"
        "+concurrency_mode": "ConcurrencyMode"
        "-_validate_interval()": "SpanInterval"
      }
      "archigram.domain.concurrency._CausalPoset": "_CausalPoset" {
        shape: class
        "+node_ids": "tuple[str, ...]"
        "+anc": "tuple[int, ...]"
        "+desc": "tuple[int, ...]"
        "+comp": "tuple[int, ...]"
      }
      "archigram.domain.concurrency.cluster_overlapping_siblings": "cluster_overlapping_siblings" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.concurrency.decompose_causal_poset": "decompose_causal_poset" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.concurrency.events_overlap": "events_overlap" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.concurrency.find_causal_overlap_span": "find_causal_overlap_span" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.concurrency.find_induced_n_witness": "find_induced_n_witness" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.concurrency.fold_parallel_map": "fold_parallel_map" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.concurrency.group_concurrent_siblings": "group_concurrent_siblings" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.concurrency.order_trace_events": "order_trace_events" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.concurrency.reconstruct_causal_order": "reconstruct_causal_order" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
    }
    "archigram.domain.diagnostics": "diagnostics" {
      style.fill: transparent
      style.stroke: "#64748b"
      "archigram.domain.diagnostics.DiagnosticSeverity": "DiagnosticSeverity" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.diagnostics.GateId": "GateId" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.diagnostics.LintDiagnostic": "LintDiagnostic" {
        shape: class
        "+gate": "GateId"
        "+severity": "DiagnosticSeverity"
        "+code": "NonBlankStr"
        "+message": "NonBlankStr"
        "+rule_id": "NonBlankStr | None"
        "+view_id": "NonBlankStr | None"
        "+offending_symbols": "tuple[NonBlankStr, ...]"
        "+witness_path": "tuple[NonBlankStr, ...]"
        "+repair_hint": "NonBlankStr"
      }
      "archigram.domain.diagnostics.LintReport": "LintReport" {
        shape: class
        "+passed": "bool"
        "+diagnostics": "tuple[LintDiagnostic, ...]"
        "-_validate_passed_invariant()": "LintReport"
        "+classmethod from_diagnostics(diagnostics: Sequence[LintDiagnostic])": "LintReport"
        "+merge(other: LintReport)": "LintReport"
        "+property error_count()": "int"
        "+property warning_count()": "int"
        "+by_gate(gate: GateId)": "tuple[LintDiagnostic, ...]"
      }
    }
    "archigram.domain.ir": "ir" {
      style.fill: transparent
      style.stroke: "#64748b"
      "archigram.domain.ir.ClassMember": "ClassMember" {
        shape: class
        "+name": "NonBlankStr"
        "+visibility": "Visibility"
        "+signature": "str"
        "+is_method": "bool"
        "+modifiers": "tuple[NonBlankStr, ...]"
        "+generic_params": "tuple[NonBlankStr, ...]"
      }
      "archigram.domain.ir.EdgeRelation": "EdgeRelation" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.ir.EventStatus": "EventStatus" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.ir.IREdge": "IREdge" {
        shape: class
        "+edge_id": "NonBlankStr"
        "+source": "NonBlankStr"
        "+target": "NonBlankStr"
        "+relation": "EdgeRelation"
        "+sync_kind": "SyncKind"
        "+weight": "float"
        "+parallel_region_id": "NonBlankStr | None"
        "+attributes": "dict[str, str]"
        "+provenance": "ValidatedProvenance"
      }
      "archigram.domain.ir.IRNode": "IRNode" {
        shape: class
        "+symbol_id": "NonBlankStr"
        "+label": "NonBlankStr"
        "+kind": "NodeKind"
        "+parent_id": "NonBlankStr | None"
        "+members": "tuple[ClassMember, ...]"
        "+attributes": "dict[str, str]"
        "+provenance": "ValidatedProvenance"
        "-_reject_self_parent()": "IRNode"
      }
      "archigram.domain.ir.InteractionTraceIR": "InteractionTraceIR" {
        shape: class
        "+schema_version": "Literal['1.0']"
        "+ir_mode": "Literal['interaction_trace']"
        "+trace_id": "NonBlankStr"
        "+participants": "dict[str, TraceParticipant]"
        "+events": "dict[str, TraceEvent]"
        "+metadata": "dict[str, str]"
        "-_validate_trace_integrity()": "InteractionTraceIR"
      }
      "archigram.domain.ir.NodeKind": "NodeKind" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.ir.StructuralGraphIR": "StructuralGraphIR" {
        shape: class
        "+schema_version": "Literal['1.0']"
        "+ir_mode": "Literal['structural_graph']"
        "+graph_id": "NonBlankStr"
        "+nodes": "dict[str, IRNode]"
        "+edges": "tuple[IREdge, ...]"
        "+metadata": "dict[str, str]"
        "-_validate_referential_integrity()": "StructuralGraphIR"
      }
      "archigram.domain.ir.SyncKind": "SyncKind" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.ir.TraceEvent": "TraceEvent" {
        shape: class
        "+event_id": "NonBlankStr"
        "+caller_id": "NonBlankStr"
        "+callee_id": "NonBlankStr"
        "+signature": "NonBlankStr"
        "+parent_event_id": "NonBlankStr | None"
        "+causal_links": "tuple[NonBlankStr, ...]"
        "+clock_domain_id": "NonBlankStr"
        "+start_ns": "int"
        "+end_ns": "int"
        "+sync_kind": "SyncKind"
        "+status": "EventStatus"
        "+attributes": "dict[str, str]"
        "+provenance": "ValidatedProvenance"
        "-_validate_event_invariants()": "TraceEvent"
      }
      "archigram.domain.ir.TraceParticipant": "TraceParticipant" {
        shape: class
        "+participant_id": "NonBlankStr"
        "+symbol_id": "NonBlankStr"
        "+label": "NonBlankStr"
        "+kind": "NodeKind"
        "+provenance": "ValidatedProvenance"
      }
      "archigram.domain.ir.Visibility": "Visibility" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.ir.export_canonical_ir_json_schemas": "export_canonical_ir_json_schemas" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.ir.validate_provenance_stamp": "validate_provenance_stamp" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
    }
    "archigram.domain.spec": "spec" {
      style.fill: transparent
      style.stroke: "#64748b"
      "archigram.domain.spec.BudgetRange": "BudgetRange" {
        shape: class
        "+min_count": "int"
        "+max_count": "int"
        "-_validate_bounds()": "BudgetRange"
      }
      "archigram.domain.spec.BypassVerticesRule": "BypassVerticesRule" {
        shape: class
        "+op": "Literal['bypass_vertices']"
        "+id": "NonBlankStr"
        "+node_id_globs": "tuple[NonBlankStr, ...]"
        "+preserve_edge_relations": "tuple[NonBlankStr, ...]"
        "+preserve_concurrency_kind": "bool"
        "+max_fanout_product": "int"
      }
      "archigram.domain.spec.CollapsePartitionRule": "CollapsePartitionRule" {
        shape: class
        "+op": "Literal['collapse_partition']"
        "+id": "NonBlankStr"
        "+target_node_id": "NonBlankStr"
        "+label": "NonBlankStr"
        "+summary": "str"
        "+member_globs": "tuple[NonBlankStr, ...]"
        "+exclude_ids": "tuple[NonBlankStr, ...]"
      }
      "archigram.domain.spec.CurationSpecV1": "CurationSpecV1" {
        shape: class
        "+schema_version": "Literal['1.0']"
        "+global_abstractions": "tuple[GlobalAbstractionRule, ...]"
        "+views": "tuple[DiagramViewSpec, ...]"
        "+metadata": "dict[str, str]"
        "-_validate_spec_uniqueness()": "CurationSpecV1"
      }
      "archigram.domain.spec.DiagramVariant": "DiagramVariant" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.spec.DiagramViewSpec": "DiagramViewSpec" {
        shape: class
        "+id": "SafeViewId"
        "+title": "NonBlankStr"
        "+ir_mode": "IRMode"
        "+target_renderer": "TargetRenderer"
        "+diagram_variant": "DiagramVariant"
        "+render_svg": "bool"
        "+animate_edges": "bool | None"
        "+rules": "tuple[ViewRule, ...]"
        "+scope": "ViewScope"
        "+simplify": "SimplifyConfig"
        "+trace_compaction": "TraceCompactionConfig"
        "+invariants": "ViewInvariants"
        "-_validate_unique_view_rules()": "DiagramViewSpec"
      }
      "archigram.domain.spec.FullScope": "FullScope" {
        shape: class
        "+mode": "Literal['full']"
      }
      "archigram.domain.spec.IRMode": "IRMode" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.spec.KHopNeighborhoodScope": "KHopNeighborhoodScope" {
        shape: class
        "+mode": "Literal['k_hop_neighborhood']"
        "+focal_nodes": "tuple[NonBlankStr, ...]"
        "+upstream_depth": "int"
        "+downstream_depth": "int"
      }
      "archigram.domain.spec.PruneLeavesRule": "PruneLeavesRule" {
        shape: class
        "+op": "Literal['prune_leaves']"
        "+id": "NonBlankStr"
        "+node_id_globs": "tuple[NonBlankStr, ...]"
        "+direction": "Literal['sink', 'root', 'both']"
      }
      "archigram.domain.spec.ReachabilityAssertion": "ReachabilityAssertion" {
        shape: class
        "+from_node": "NonBlankStr"
        "+to_node": "NonBlankStr"
        "+via_relations": "tuple[NonBlankStr, ...]"
      }
      "archigram.domain.spec.SimplifyConfig": "SimplifyConfig" {
        shape: class
        "+condense_sccs": "bool"
        "+transitive_reduction": "bool"
      }
      "archigram.domain.spec.TargetRenderer": "TargetRenderer" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.spec.TraceCompactionConfig": "TraceCompactionConfig" {
        shape: class
        "+fold_loops": "bool"
        "+fold_loop_with_opt": "bool"
        "+cut_recursion": "bool"
        "+fold_parallel_siblings": "bool"
        "+parallel_epsilon_ns": "int"
        "+fold_parallel_map": "bool"
        "+max_par_branches": "int"
        "+decompose_series_parallel": "bool"
        "+max_call_depth": "int | None"
      }
      "archigram.domain.spec.ViewInvariants": "ViewInvariants" {
        shape: class
        "+protected_nodes": "tuple[NonBlankStr, ...]"
        "+preserve_reachability": "tuple[ReachabilityAssertion, ...]"
        "+require_reachability": "tuple[ReachabilityAssertion, ...]"
        "+preserve_partial_order": "bool"
        "+forbid_new_cycles": "bool"
        "+node_budget": "BudgetRange"
        "+edge_budget_max": "int"
        "+overflow_strategy": "Literal['fail', 'spanning_tree_table']"
      }
      "archigram.domain.spec.dump_curation_spec_yaml": "dump_curation_spec_yaml" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.spec.export_curation_spec_json_schema": "export_curation_spec_json_schema" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.spec.parse_curation_spec_yaml": "parse_curation_spec_yaml" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.spec.validate_safe_view_id": "validate_safe_view_id" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
    }
    "archigram.domain.style": "style" {
      style.fill: transparent
      style.stroke: "#64748b"
      "archigram.domain.style.EdgeVisualStyle": "EdgeVisualStyle" {
        shape: class
        "+relation": "EdgeRelation"
        "+stroke_hex": "str"
        "+likec4_color": "str"
        "+line_pattern": "LinePattern"
        "+uml_arrowhead": "UmlArrowheadKind"
        "+dot_arrowhead": "str"
        "+dot_arrowtail": "str | None"
        "+animated": "bool"
        "+usage_note": "str"
      }
      "archigram.domain.style.LinePattern": "LinePattern" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.style.MermaidThemeConfig": "MermaidThemeConfig" {
        shape: class
        "+schema_version": "Literal['1.0']"
        "+layout_engine": "Literal['elk', 'dagre']"
        "+elk_merge_edges": "bool"
        "+elk_node_placement_strategy": "Literal['BRANDES_KOEPF', 'NETWORK_SIMPLEX', 'LINEAR_SEGMENTS', 'SIMPLE']"
        "+flowchart_curve": "Literal['linear', 'basis', 'stepBefore', 'stepAfter']"
        "+sequence_mirror_actors": "bool"
        "+node_fill": "Literal['transparent']"
        "+node_border_hex": "str"
        "+node_border_width_px": "str"
        "+subgraph_border_hex": "str"
        "+subgraph_border_width_px": "str"
        "+subgraph_dash_array": "str"
        "+edge_stroke_width_px": "str"
        "+bold_edge_stroke_width_px": "str"
        "+dashed_edge_array": "str"
        "+web_light": "MermaidWebModePalette"
        "+web_dark": "MermaidWebModePalette"
        "-_validate_dual_mode_bounds()": "MermaidThemeConfig"
        "+structural_frontmatter()": "str"
        "+sequence_frontmatter()": "str"
        "+state_frontmatter()": "str"
        "+default_classdef()": "str"
        "+subgraph_style_attrs()": "str"
        "+web_theme_variables(mode: Literal['light', 'dark'])": "dict[str, str | bool]"
      }
      "archigram.domain.style.MermaidWebModePalette": "MermaidWebModePalette" {
        shape: class
        "+background_hex": "str"
        "+surface_hex": "str"
        "+text_hex": "str"
        "+muted_text_hex": "str"
        "+border_hex": "str"
        "+line_hex": "str"
        "+signal_hex": "str"
        "-_validate_contrast()": "MermaidWebModePalette"
      }
      "archigram.domain.style.UmlArrowheadKind": "UmlArrowheadKind" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.style.contrast_ratio": "contrast_ratio" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.style.dump_mermaid_theme_yaml": "dump_mermaid_theme_yaml" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.style.parse_mermaid_theme_yaml": "parse_mermaid_theme_yaml" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.style.relative_luminance": "relative_luminance" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.style.render_mermaid_web_theme_js": "render_mermaid_web_theme_js" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.style.resolve_edge_animated": "resolve_edge_animated" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      "archigram.domain.style.resolve_edge_visual_style": "resolve_edge_visual_style" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
    }
    "archigram.domain.validate_non_blank": "validate_non_blank" {
      style.fill: transparent
      style.stroke: "#64748b"
    }
  }
  "archigram.entrypoints": "entrypoints" {
    style.fill: transparent
    style.stroke: "#64748b"
    "archigram.entrypoints.cli": "cli" {
      style.fill: transparent
      style.stroke: "#64748b"
      "archigram.entrypoints.cli.app": "app" {
        style.fill: transparent
        style.stroke: "#64748b"
        "archigram.entrypoints.cli.app.ApplyOptions": "ApplyOptions" {
          shape: class
          "+input_path": "Path"
          "+spec_path": "Path"
          "+out_dir": "Path"
          "+input_format": "InputFormat"
          "+check_only": "bool"
          "+sync_md": "Path | None"
          "+mermaid_theme": "Path | None"
        }
        "archigram.entrypoints.cli.app.DiffOptions": "DiffOptions" {
          shape: class
          "+base_path": "Path | None"
          "+head_path": "Path"
          "+spec_path": "Path"
          "+input_format": "InputFormat"
          "+output_json": "bool"
        }
        "archigram.entrypoints.cli.app.LintOptions": "LintOptions" {
          shape: class
          "+input_path": "Path"
          "+spec_path": "Path"
          "+input_format": "InputFormat"
          "+output_json": "bool"
          "+mermaid_theme": "Path | None"
        }
        "archigram.entrypoints.cli.app.apply_cmd": "apply_cmd" {
          style.fill: transparent
          style.stroke: "#64748b"
        }
        "archigram.entrypoints.cli.app.apply_regeneration_command": "apply_regeneration_command" {
          style.fill: transparent
          style.stroke: "#64748b"
        }
        "archigram.entrypoints.cli.app.build_apply_check_report": "build_apply_check_report" {
