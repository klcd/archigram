}
"archigram.features.lint_syntax.validators": "[KEEP] validators" {
  style.fill: transparent
  style.stroke: "#10b981"
}
"archigram.features.lint_topology.gate": "[KEEP] lint_topology.gate" {
  style.fill: transparent
  style.stroke: "#10b981"
}
"archigram.features.reduce_structural.reducer": "[KEEP] reducer" {
  style.fill: transparent
  style.stroke: "#10b981"
}
