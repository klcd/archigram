vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    dark-theme-id: 200
  }
}
style.fill: transparent

direction: right
triage_legend: "Triage Disposition Legend" {
  style.fill: transparent
  style.stroke: "#64748b"
  style.stroke-dash: 3
  keep_key: "[KEEP] Retained in final view" {
    style.fill: transparent
    style.stroke: "#10b981"
  }
  remove_key: "[REMOVE] Pruned / out-of-scope" {
    style.fill: transparent
    style.stroke: "#ef4444"
    style.stroke-dash: 5
  }
  bypass_key: "[BYPASS] Spliced intermediate" {
    style.fill: transparent
    style.stroke: "#f59e0b"
    style.stroke-dash: 5
  }
  collapse_key: "[COLLAPSE] Merged into supernode" {
    style.fill: transparent
    style.stroke: "#8b5cf6"
    style.stroke-dash: 5
  }
}
"archigram.domain.diagnostics": "[KEEP] diagnostics" {
  style.fill: transparent
  style.stroke: "#10b981"
}
"archigram.domain.ir": "[REMOVE] ir" {
  style.fill: transparent
  style.stroke: "#ef4444"
  style.stroke-dash: 5
}
"archigram.domain.spec": "[KEEP] spec" {
  style.fill: transparent
  style.stroke: "#10b981"
}
"archigram.domain.style": "[REMOVE] style" {
  style.fill: transparent
  style.stroke: "#ef4444"
  style.stroke-dash: 5
}
"archigram.entrypoints.cli.pipeline": "[KEEP] pipeline" {
  style.fill: transparent
  style.stroke: "#10b981"
}
"archigram.entrypoints.mcp.propose_loop": "[KEEP] propose_loop" {
  style.fill: transparent
  style.stroke: "#10b981"
}
"archigram.features.digest.generator": "[KEEP] generator" {
  style.fill: transparent
  style.stroke: "#10b981"
}
"archigram.features.emit_d2.emitter": "[REMOVE] emit_d2.emitter" {
  style.fill: transparent
  style.stroke: "#ef4444"
  style.stroke-dash: 5
}
"archigram.features.emit_mermaid.emitter": "[KEEP] emit_mermaid.emitter" {
  style.fill: transparent
  style.stroke: "#10b981"
}
