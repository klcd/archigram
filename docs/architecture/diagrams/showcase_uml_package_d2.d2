vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    dark-theme-id: 200
  }
}
style.fill: transparent

direction: down
archigram: "<<package>> archigram" {
  style.fill: transparent
  style.stroke: "#64748b"
  "archigram.entrypoints": "<<package>> entrypoints" {
    style.fill: transparent
    style.stroke: "#64748b"
    cli_dataplane: "<<package>> CLI Data Plane (entrypoints.cli)" {
      shape: package
      style.fill: transparent
      style.stroke: "#64748b"
    }
    mcp_controlplane: "<<package>> MCP Control Plane (entrypoints.mcp)" {
      shape: package
      style.fill: transparent
      style.stroke: "#64748b"
    }
  }
  "archigram.features": "<<package>> features" {
    style.fill: transparent
    style.stroke: "#64748b"
    feature_digest: "<<package>> Digest Slice (Graph & Trace)" {
      shape: package
      style.fill: transparent
      style.stroke: "#64748b"
    }
    feature_emitters: "<<package>> Emitter Slices (Mermaid, D2, PlantUML, LikeC4)" {
      shape: package
      style.fill: transparent
      style.stroke: "#64748b"
    }
    feature_ingestors: "<<package>> Ingestor Slices (5 Extractors)" {
      shape: package
      style.fill: transparent
      style.stroke: "#64748b"
    }
    feature_linters: "<<package>> 5-Gate Linter Slices" {
      shape: package
      style.fill: transparent
      style.stroke: "#64748b"
    }
    feature_reducers: "<<package>> Reducer Slices (Graph & Trace)" {
      shape: package
      style.fill: transparent
      style.stroke: "#64748b"
    }
  }
  domain_core: "<<package>> Domain Core (Canonical IR, Spec, Style)" {
    shape: package
    style.fill: transparent
    style.stroke: "#64748b"
  }
  ports_contracts: "<<package>> Ports & Contracts (archigram.ports)" {
    shape: package
    style.fill: transparent
    style.stroke: "#64748b"
  }
}
archigram."archigram.entrypoints".cli_dataplane -> archigram: "<<import>>" {
  style.stroke: "#64748b"
  style.stroke-dash: 5
}
