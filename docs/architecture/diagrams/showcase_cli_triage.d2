  style.stroke-dash: 5
}
archigram."archigram.entrypoints"."archigram.entrypoints.cli"."archigram.entrypoints.cli.pipeline" -> archigram."archigram.features".reducer_slices: "imports" {
  style.stroke: "#64748b"
  style.stroke-dash: 5
}
archigram."archigram.entrypoints"."archigram.entrypoints.cli".cli_commands -> archigram: "imports" {
