}
archigram."archigram.domain".domain_style -> archigram."archigram.domain".domain_core: "imports" {
  style.stroke: "#64748b"
  style.stroke-dash: 5
}
archigram."archigram.features".emitter_slices -> archigram."archigram.domain".domain_style: "imports" {
