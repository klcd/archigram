vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    dark-theme-id: 200
  }
}
style.fill: transparent

archigram: "archigram" {
  style.fill: transparent
  style.stroke: "#64748b"
  "archigram.domain": "domain" {
    style.fill: transparent
    style.stroke: "#64748b"
    domain_core: "Domain Core (Canonical IR, Spec, Diagnostics)" {
      style.fill: transparent
      style.stroke: "#64748b"
      tooltip: "Derived via fold_domain_core (3 backing nodes: archigram.domain.diagnostics, archigram.domain.ir, archigram.domain.spec)"
    }
    domain_style: "Canonical Dual-Mode Style Policy (domain.style)" {
      style.fill: transparent
      style.stroke: "#64748b"
      tooltip: "Derived via fold_domain_style (1 backing node: archigram.domain.style)"
    }
  }
  "archigram.entrypoints": "entrypoints" {
    style.fill: transparent
    style.stroke: "#64748b"
    "archigram.entrypoints.cli": "cli" {
      style.fill: transparent
      style.stroke: "#64748b"
      "archigram.entrypoints.cli.pipeline": "pipeline" {
        style.fill: transparent
        style.stroke: "#64748b"
      }
      cli_commands: "CLI Commands (app, triage, diff, sync)" {
        style.fill: transparent
        style.stroke: "#64748b"
        tooltip: "Derived via fold_cli_callers (4 backing nodes: archigram.entrypoints.cli.app, archigram.entrypoints.cli.diff_report, archigram.entrypoints.cli.self_trace, archigram.entrypoints.cli.triage)"
      }
    }
  }
  "archigram.features": "features" {
    style.fill: transparent
    style.stroke: "#64748b"
    emitter_slices: "Multi-Target Emitter Slices" {
      style.fill: transparent
      style.stroke: "#64748b"
      tooltip: "Derived via fold_emitters (8 backing nodes: archigram.features.emit_d2.emitter, archigram.features.emit_d2.emitter.D2Emitter, archigram.features.emit_likec4.emitter, archigram.features.emit_likec4.emitter.LikeC4Emitter, archigram.features.emit_mermaid.emitter, ...)"
    }
    ingestor_slices: "Ingestor Slices (5 Extractors)" {
      style.fill: transparent
      style.stroke: "#64748b"
      tooltip: "Derived via fold_ingestors (5 backing nodes: archigram.features.ingest_class, archigram.features.ingest_dot, archigram.features.ingest_otel, archigram.features.ingest_python, archigram.features.ingest_scip)"
    }
    linter_slices: "5-Gate Linter Slices" {
      style.fill: transparent
      style.stroke: "#64748b"
      tooltip: "Derived via fold_linters (4 backing nodes: archigram.features.lint_budget, archigram.features.lint_grounding, archigram.features.lint_syntax, archigram.features.lint_topology)"
    }
    reducer_slices: "Reducer Slices (Graph & Trace)" {
      style.fill: transparent
      style.stroke: "#64748b"
      tooltip: "Derived via fold_reducers (2 backing nodes: archigram.features.reduce_structural, archigram.features.reduce_trace)"
    }
  }
}

archigram."archigram.entrypoints"."archigram.entrypoints.cli" -> archigram."archigram.entrypoints"."archigram.entrypoints.cli".cli_commands: "imports" {
  style.stroke: "#64748b"
  style.stroke-dash: 5
}
archigram."archigram.entrypoints"."archigram.entrypoints.cli"."archigram.entrypoints.cli.pipeline" -> archigram."archigram.features".emitter_slices: "calls" {
  style.stroke: "#3b82f6"
  style.animated: true
}
